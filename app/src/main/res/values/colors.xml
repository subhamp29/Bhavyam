<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- hsl(0, 5%, 6%): the same formula Md3SchemeBuilder uses for the md
         background token, evaluated at the default hue so the splash screen
         never flashes a mismatched color. -->
    <color name="splash_background">#FF100F0F</color>

    <!-- Historical accent: the lime used by earlier icon artwork and still
         referenced by the Settings screen. NOT the adaptive icon background
         layer - see ic_launcher_adaptive_bg below. -->
    <color name="ic_launcher_background">#FFC9FB00</color>

    <!-- Adaptive icon background LAYER (separate from the colour above, which
         SettingsScreen also uses as a UI accent). The shipped launcher artwork
         is a mark on black, so the layer is black: compositing the foreground
         over it reproduces exactly what users saw before the layer split.
         Kept as its own colour so the lime stays available to the UI. -->
    <color name="ic_launcher_adaptive_bg">#FF000000</color>
</resources>
